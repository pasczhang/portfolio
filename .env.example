# API
APP_ENV=development
APP_NAME=hk-mmf-pms
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# PostgreSQL + TimescaleDB
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mmf_pms
POSTGRES_USER=pms
POSTGRES_PASSWORD=pms
DATABASE_URL=postgresql+asyncpg://pms:pms@localhost:5432/mmf_pms
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_POSITION_TTL_SECONDS=15

# Auth (replace in production)
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
